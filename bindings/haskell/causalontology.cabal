cabal-version:      2.4

-- The Haskell binding of the Causalontology standard.
name:               causalontology
version:            4.0.0
synopsis:           The Haskell binding of the Causalontology standard
description:
  The Haskell binding of the Causalontology standard - a verb-first
  noun-hosting ontology; reified causation as a programming-language-neutral standard
  and shared commons. GHC-bundled packages only: RFC 8785 canonicalization,
  SHA-256 identity, pure-Haskell Ed25519 (RFC 8032), schema and semantics
  validation, and an in-memory conformant store.
  .
  License: "The attribution always; no profit, no problem license."
  (Apache License 2.0 text; see the LICENSE file and the repository NOTICE.)
author:             AI University (AIU)
maintainer:         ai.university.aiu@gmail.com
homepage:           https://github.com/ai-university-aiu/causalontology
bug-reports:        https://github.com/ai-university-aiu/causalontology/issues
license:            Apache-2.0
license-file:       LICENSE
category:           Data
build-type:         Simple
extra-doc-files:    README.md
-- app/Paths_causalontology.hs is the runghc-only stand-in for the
-- Cabal-generated Paths module (see autogen-modules below); Cabal never
-- compiles it, but shipping it keeps the tarball a faithful copy of the
-- source tree, so the no-Cabal conformance route works from the tarball too.
extra-source-files:
  app/Paths_causalontology.hs
  spec_schema/README.md

-- The twenty-one normative JSON Schemas, vendored from spec/schema so the
-- published package validates standalone with no repository checkout.
-- Resolved at run time through Paths_causalontology.getDataFileName.
data-files:
  spec_schema/assertion.schema.json
  spec_schema/attitude.schema.json
  spec_schema/bridge.schema.json
  spec_schema/causal_relation_object.schema.json
  spec_schema/conduit.schema.json
  spec_schema/continuant.schema.json
  spec_schema/cross_stratal_seam.schema.json
  spec_schema/enrichment.schema.json
  spec_schema/individual.schema.json
  spec_schema/occurrent.schema.json
  spec_schema/port.schema.json
  spec_schema/predicted_occurrence.schema.json
  spec_schema/prediction_error.schema.json
  spec_schema/quality.schema.json
  spec_schema/realizable.schema.json
  spec_schema/retraction.schema.json
  spec_schema/state.schema.json
  spec_schema/stratum.schema.json
  spec_schema/succession.schema.json
  spec_schema/token.schema.json
  spec_schema/token_causal_claim.schema.json

source-repository head
  type:     git
  location: https://github.com/ai-university-aiu/causalontology

common shared
  default-language:   Haskell2010
  default-extensions:
    BangPatterns
    LambdaCase
    TupleSections
  ghc-options:        -Wall

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Causalontology.Canonical
    Causalontology.Ed25519
    Causalontology.Jcs
    Causalontology.Json
    Causalontology.Schema
    Causalontology.Semantics
    Causalontology.Sha2
    Causalontology.Signing
    Causalontology.Store
  other-modules:   Paths_causalontology
  autogen-modules: Paths_causalontology
  build-depends:
      base        >=4.14 && <5
    , bytestring  >=0.10 && <0.13
    , containers  >=0.6  && <0.9
    , directory   >=1.3  && <1.4
    , filepath    >=1.4  && <1.6

executable conformance
  import:         shared
  hs-source-dirs: app
  main-is:        Conformance.hs
  build-depends:
      base        >=4.14 && <5
    , bytestring  >=0.10 && <0.13
    , containers  >=0.6  && <0.9
    , causalontology
    , directory   >=1.3  && <1.4
    , filepath    >=1.4  && <1.6
