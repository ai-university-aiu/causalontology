{
  "@context": {
    "@version": 1.1,

    "co": "https://causalontology.org/ns#",
    "bfo": "http://purl.obolibrary.org/obo/BFO_",
    "ro": "http://purl.obolibrary.org/obo/RO_",
    "prov": "http://www.w3.org/ns/prov#",

    "@vocab": "https://causalontology.org/ns#",

    "id": "@id",
    "type": {
      "@id": "@type",
      "@type": "@vocab",
      "@context": {
        "stratum": "co:Stratum",
        "quality": "co:Quality",
        "realizable": "co:Realizable"
      }
    },

    "causal_relation_object": "co:CausalRelationObject",
